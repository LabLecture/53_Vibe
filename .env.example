# 이 파일을 .env 로 복사한 뒤 본인 값으로 채운다. .env 는 커밋되지 않는다(.gitignore).
#
# Day 3 · 6.5 — Discord 채널 웹훅 URL
#   채널 우클릭 → 채널 편집 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=

# Day 3 · 8.2+ — PostgreSQL 접속 정보 (Day 2 8교시 컨테이너)
#   비워 두면 store/ 가 로컬 SQLite 파일(vibe.db)로 폴백한다 → DB 없이도 실습 가능
# DATABASE_URL=postgresql://vibe_user:비밀번호@localhost:5432/vibe

# ⚠️ Python 은 .env 를 자동으로 읽지 않는다 (bun 과 다르다 — 교안 6.11).
#    파이프라인 진입점에서 한 번 올려 준다:
