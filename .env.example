# 이 파일을 .env 로 복사한 뒤 본인 값으로 채운다. .env 는 커밋되지 않는다(.gitignore).
#
# Day 3 · 6.5 — Discord 채널 웹훅 URL
#   채널 우클릭 → 채널 편집 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=

# ⚠️ Python 은 .env 를 자동으로 읽지 않는다 (bun 과 다르다 — 교안 6.11).
